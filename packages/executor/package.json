{
    "name": "@lab/executor",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "exports": {
            "./constants": "./dist/constants.js",
            "./errors": "./dist/errors.js",
            "./run": "./dist/run.js",
            "./types": "./dist/types.js"
        },
        "imports": {
            "#src/*": "./dist/*.js"
        }
    },
    "exports": {
        "./constants": "./src/constants.ts",
        "./errors": "./src/errors.ts",
        "./run": "./src/run.ts",
        "./types": "./src/types.ts"
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "execa": "10.0.1",
        "write-file-atomic": "8.0.0"
    },
    "devDependencies": {
        "@types/write-file-atomic": "4.0.3"
    }
}
