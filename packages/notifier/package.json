{
    "name": "@openlab/notifier",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "exports": {
            "./notification-channel.types": "./dist/notification-channel/notification-channel.types.js",
            "./notification-delivery-error": "./dist/notification-channel/notification-delivery-error.js",
            "./notification-delivery-error.const": "./dist/notification-channel/notification-delivery-error.const.js",
            "./notification-message.types": "./dist/notification-channel/notification-message.types.js",
            "./telegram-bot-channel": "./dist/telegram-bot/telegram-bot-channel.js",
            "./telegram-bot-channel.const": "./dist/telegram-bot/telegram-bot-channel.const.js",
            "./telegram-bot-channel.types": "./dist/telegram-bot/telegram-bot-channel.types.js",
            "./telegram-bot-conversation": "./dist/telegram-bot/telegram-bot-conversation.js"
        },
        "imports": {
            "#src/*": "./dist/*.js"
        }
    },
    "exports": {
        "./notification-channel.types": "./src/notification-channel/notification-channel.types.ts",
        "./notification-delivery-error": "./src/notification-channel/notification-delivery-error.ts",
        "./notification-delivery-error.const": "./src/notification-channel/notification-delivery-error.const.ts",
        "./notification-message.types": "./src/notification-channel/notification-message.types.ts",
        "./telegram-bot-channel": "./src/telegram-bot/telegram-bot-channel.ts",
        "./telegram-bot-channel.const": "./src/telegram-bot/telegram-bot-channel.const.ts",
        "./telegram-bot-channel.types": "./src/telegram-bot/telegram-bot-channel.types.ts",
        "./telegram-bot-conversation": "./src/telegram-bot/telegram-bot-conversation.ts"
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@openlab/protocol": "workspace:*"
    }
}
