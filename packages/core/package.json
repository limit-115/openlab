            "./investigation-lifecycle/investigation-state-transitions": "./dist/investigation-lifecycle/investigation-state-transitions.js",
            "./investigation-lifecycle/investigation-state-transitions.const": "./dist/investigation-lifecycle/investigation-state-transitions.const.js",
            "./investigation-lifecycle/investigation-state-transitions.types": "./dist/investigation-lifecycle/investigation-state-transitions.types.js",
            "./investigation-lifecycle/wake-trigger.const": "./dist/investigation-lifecycle/wake-trigger.const.js"
        },
        "imports": {
            "#src/*": "./dist/*.js"
        }
    },
    "exports": {
        "./lab-installation/shipped-directory": "./src/lab-installation/shipped-directory.ts",
        "./lab-installation/shipped-directory.const": "./src/lab-installation/shipped-directory.const.ts",
        "./investigation-lifecycle/investigation-state-transitions": "./src/investigation-lifecycle/investigation-state-transitions.ts",
        "./investigation-lifecycle/investigation-state-transitions.const": "./src/investigation-lifecycle/investigation-state-transitions.const.ts",
