    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@nightlab/protocol": "workspace:*"
    }
}
