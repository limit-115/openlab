{
    "name": "@lab/core",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./investigation-lifecycle/investigation-state-transitions": "./src/investigation-lifecycle/investigation-state-transitions.ts",
        "./investigation-lifecycle/investigation-state-transitions.const": "./src/investigation-lifecycle/investigation-state-transitions.const.ts",
        "./investigation-lifecycle/investigation-state-transitions.types": "./src/investigation-lifecycle/investigation-state-transitions.types.ts",
        "./investigation-lifecycle/wake-trigger.const": "./src/investigation-lifecycle/wake-trigger.const.ts"
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
        "test:integration": "vitest run '**/*.integration.test.ts' --passWithNoTests",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@lab/protocol": "workspace:*"
    }
}
