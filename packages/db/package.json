{
    "name": "@lab/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./lab-database/lab-database-client": "./src/lab-database/lab-database-client.ts",
        "./lab-database/lab-schema": "./src/lab-database/lab-schema.ts",
        "./lab-database/lab-schema-migration": "./src/lab-database/lab-schema-migration.ts",
        "./lab-database/test-database": "./src/lab-database/test-database.ts",
        "./investigations/investigation-repository": "./src/investigations/investigation-repository.ts",
        "./lab-settings/lab-settings-repository": "./src/lab-settings/lab-settings-repository.ts",
        "./operator-notifications/notification-settings-repository": "./src/operator-notifications/notification-settings-repository.ts",
        "./investigations/investigation-repository.types": "./src/investigations/investigation-repository.types.ts",
        "./runtime/incompatible-checkpoint": "./src/runtime/incompatible-checkpoint.ts",
        "./runtime/runtime-persistence": "./src/runtime/runtime-persistence.ts",
        "./runtime/runtime-persistence.types": "./src/runtime/runtime-persistence.types.ts",
        "./runtime/runtime-revision-conflict": "./src/runtime/runtime-revision-conflict.ts"
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "db:generate": "drizzle-kit generate",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@lab/core": "workspace:*",
        "@lab/protocol": "workspace:*",
        "drizzle-orm": "0.45.2"
    },
    "devDependencies": {
        "drizzle-kit": "0.31.10"
    }
}
