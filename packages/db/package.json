{
    "name": "@nightlab/db",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "files": [
        "dist",
        "migrations"
    ],
    "publishConfig": {
        "exports": {
            "./lab-database/lab-database-client": "./dist/lab-database/lab-database-client.js",
            "./lab-database/lab-schema": "./dist/lab-database/lab-schema.js",
            "./lab-database/lab-schema-migration": "./dist/lab-database/lab-schema-migration.js",
            "./investigations/investigation-repository": "./dist/investigations/investigation-repository.js",
            "./lab-settings/lab-settings-repository": "./dist/lab-settings/lab-settings-repository.js",
            "./operator-notifications/notification-settings-repository": "./dist/operator-notifications/notification-settings-repository.js",
            "./investigations/investigation-repository.types": "./dist/investigations/investigation-repository.types.js",
            "./runtime/incompatible-checkpoint": "./dist/runtime/incompatible-checkpoint.js",
            "./runtime/runtime-persistence": "./dist/runtime/runtime-persistence.js",
            "./runtime/runtime-persistence.types": "./dist/runtime/runtime-persistence.types.js",
            "./runtime/runtime-revision-conflict": "./dist/runtime/runtime-revision-conflict.js"
        },
        "imports": {
            "#src/*": "./dist/*.js"
        }
    },
    "exports": {
        "./lab-database/lab-database-client": "./src/lab-database/lab-database-client.ts",
        "./lab-database/lab-schema": "./src/lab-database/lab-schema.ts",
        "./lab-database/lab-schema-migration": "./src/lab-database/lab-schema-migration.ts",
        "./lab-database/test-database": "./src/lab-database/test-database.ts",
        "./investigations/investigation-repository": "./src/investigations/investigation-repository.ts",
        "./lab-settings/lab-settings-repository": "./src/lab-settings/lab-settings-repository.ts",
        "./operator-notifications/notification-settings-repository": "./src/operator-notifications/notification-settings-repository.ts",
        "./investigations/investigation-repository.types": "./src/investigations/investigation-repository.types.ts",
        "./runtime/incompatible-checkpoint": "./src/runtime/incompatible-checkpoint.ts",
        "./runtime/runtime-persistence": "./src/runtime/runtime-persistence.ts",
        "./runtime/runtime-persistence.types": "./src/runtime/runtime-persistence.types.ts",
        "./runtime/runtime-revision-conflict": "./src/runtime/runtime-revision-conflict.ts"
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "db:generate": "drizzle-kit generate",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@nightlab/core": "workspace:*",
        "@nightlab/protocol": "workspace:*",
        "drizzle-orm": "0.45.2"
    },
    "devDependencies": {
        "drizzle-kit": "0.31.10"
    }
}
