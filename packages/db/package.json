{
    "name": "@lab/db",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "exports": {
        "./lab-database/lab-database-client": "./src/lab-database/lab-database-client.ts",
        "./lab-database/lab-schema": "./src/lab-database/lab-schema.ts",
        "./lab-database/lab-schema-migration": "./src/lab-database/lab-schema-migration.ts",
        "./lab-database/postgres-test-container": "./src/lab-database/postgres-test-container.ts",
        "./labs/lab-repository": "./src/labs/lab-repository.ts",
        "./labs/lab-repository.types": "./src/labs/lab-repository.types.ts",
        "./runtime/incompatible-checkpoint": "./src/runtime/incompatible-checkpoint.ts",
        "./runtime/runtime-persistence": "./src/runtime/runtime-persistence.ts",
        "./runtime/runtime-persistence.types": "./src/runtime/runtime-persistence.types.ts",
        "./runtime/runtime-revision-conflict": "./src/runtime/runtime-revision-conflict.ts"
    },
    "imports": {
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "test:integration": "vitest run --project integration",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@lab/core": "workspace:*",
        "@lab/protocol": "workspace:*",
        "drizzle-orm": "0.45.2",
        "postgres": "3.4.9"
    },
    "devDependencies": {
        "@testcontainers/postgresql": "12.0.4",
        "drizzle-kit": "0.31.10"
    }
}
