{
    "name": "openlab",
    "version": "0.0.0",
    "private": true,
    "license": "Apache-2.0",
    "description": "Local autonomous AI research runtime",
    "type": "module",
    "packageManager": "pnpm@11.18.0",
    "engines": {
        "node": ">=24.18.1 <25"
    },
    "imports": {
        "#release/*": "./release/*.ts"
    },
    "scripts": {
        "openlab": "node apps/cli/src/main.ts",
        "release": "bun release/build-release.ts",
        "build": "pnpm -r --if-present build",
        "typecheck": "pnpm -r --if-present typecheck && tsc -p release/tsconfig.json",
        "test": "pnpm -r --if-present test",
        "prepare": "lefthook install",
        "lint": "biome lint .",
        "format": "biome format --write .",
        "check": "biome check . && pnpm typecheck && pnpm test && pnpm build",
        "clean": "pnpm -r --if-present clean"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.6",
        "@openlab/core": "workspace:*",
        "@types/node": "24.13.3",
        "execa": "10.0.1",
        "lefthook": "2.1.10",
        "typescript": "7.0.2",
        "vitest": "4.1.10"
    }
}
