{
    "name": "@lab/cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "lab": "./bin/lab.js"
    },
    "engines": {
        "node": ">=24.18.1"
    },
    "imports": {
        "#bin/*": "./bin/*",
        "#src/*": "./src/*.ts"
    },
    "scripts": {
        "start": "node src/main.ts",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run --passWithNoTests",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@clack/prompts": "1.7.0",
        "@lab/daemon": "workspace:*",
        "@lab/protocol": "workspace:*",
        "@t3-oss/env-core": "0.13.11",
        "cli-table3": "0.6.5",
        "commander": "15.0.0",
        "consola": "3.4.2",
        "open": "11.0.0",
        "zod": "4.4.3"
    }
}
