{
    "name": "@openlab/cli",
    "version": "0.1.0",
    "private": true,
    "license": "Apache-2.0",
    "type": "module",
    "files": [
        "dist",
        "bin"
    ],
    "publishConfig": {
        "imports": {
            "#bin/*": "./bin/*",
            "#src/*": "./dist/*.js"
        }
    },
    "bin": {
        "openlab": "./bin/openlab.js"
    },
    "engines": {
        "node": ">=24.18.1"
    },
    "imports": {
        "#bin/*": "./bin/*",
        "#src/*": "./src/*.ts",
        "#package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node src/main.ts",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run --passWithNoTests",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@clack/prompts": "1.7.0",
        "@openlab/daemon": "workspace:*",
        "@openlab/protocol": "workspace:*",
        "@t3-oss/env-core": "0.13.11",
        "cli-table3": "0.6.5",
        "commander": "15.0.0",
        "consola": "3.4.2",
        "execa": "10.0.1",
        "open": "11.0.0",
        "semver": "7.8.5",
        "write-file-atomic": "8.0.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/semver": "7.8.0",
        "@types/write-file-atomic": "4.0.3"
    }
}
