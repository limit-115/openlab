---
import FirstRun from "#src/first-run/first-run.astro";
import Guardrails from "#src/guardrails/guardrails.astro";
import HarnessRoster from "#src/harness-roster/harness-roster.astro";
import LabClaim from "#src/lab-claim/lab-claim.astro";
import ResearchLoop from "#src/research-loop/research-loop.astro";
import SiteFooter from "#src/site-footer/site-footer.astro";
import SiteHeader from "#src/site-header/site-header.astro";
import SiteMetadata from "#src/site-metadata/site-metadata.astro";
import StartALab from "#src/start-a-lab/start-a-lab.astro";
import "#src/tailwind.css";

/**
 * The whole site, in the order a reader asks their questions: what is this and how do I get it,
 * what does it think with and who pays for that, what does it do while I am not looking, what does
 * it take to start, what will it not do to me, and then the command again.
 *
 * The page is laid out as one sheet under registration rails, which is the product mark drawn at
 * the scale of a page: the lab is a boundary you own and the work happens within it. Every section
 * is a plate on that sheet, divided by a hairline rather than by empty space.
 */
---

<html lang="en">
    <head>
        <SiteMetadata />
    </head>
    <body class="min-w-80">
        <div class="mx-auto max-w-7xl border-border sm:border-x">
            <SiteHeader />
            <main>
                <LabClaim />
                <HarnessRoster />
                <ResearchLoop />
                <FirstRun />
                <Guardrails />
                <StartALab />
            </main>
            <SiteFooter />
        </div>
    </body>
</html>
