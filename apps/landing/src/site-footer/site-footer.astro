---
import { FOOTER_LINK } from "#src/site-footer/site-footer.const";

/**
 * The sign-off. The name is set at the width of the sheet and in the ground's own quieter step, so
 * it closes the page without competing with the accent field above it. It is live text in the
 * product's typeface rather than a drawing, and it is written OpenLab — the way a person reads it,
 * never the way a package manager does.
 */
---

<footer class="border-t border-border">
    <div class="flex flex-wrap items-center justify-between gap-6 px-6 py-8 sm:px-10">
        <p class="max-w-md text-pretty text-muted-foreground">
            A research lab that runs on your machine, released under Apache-2.0. Run it, change it,
            ship it inside something else.
        </p>
        <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-6 gap-y-2">
            {
                FOOTER_LINK.map((link) => (
                    <a
                        href={link.href}
                        {...(link.external
                            ? { target: "_blank", rel: "noopener noreferrer" }
                            : {})}
                        class="text-sm text-muted-foreground uppercase transition-colors hover:text-foreground"
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>
    </div>

    <div class="border-t border-border px-6 py-10 sm:px-10 sm:py-14">
        <p class="text-[clamp(3.5rem,19vw,16rem)] leading-[0.95] font-[700] text-surface">
            OpenLab
        </p>
    </div>
</footer>
