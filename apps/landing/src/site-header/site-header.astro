---
import OpenLabLockup from "#src/brand/openlab-lockup.astro";
import { HEADER_LINK } from "#src/site-header/site-header.const";
import { REPOSITORY_URL } from "#src/site-metadata/site-metadata.const";

/**
 * The bar that stands over the sheet. It stays put while the page moves under it, because the one
 * thing a reader should never have to hunt for is the command that installs this — so the install
 * pill is on screen from the first scroll to the last.
 *
 * Below `md` the section links go and the two actions stay. The page is one document reachable by
 * scrolling, so a menu behind a button would be a second way to do the thing scrolling already
 * does, and one more control to explain.
 */
---

<header
    class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur-md"
>
    <div class="flex items-center justify-between gap-6 px-6 py-3 sm:px-10">
        <a href="#top" class="shrink-0 transition-opacity hover:opacity-70" aria-label="OpenLab">
            <OpenLabLockup />
        </a>

        <nav aria-label="Sections" class="hidden flex-1 items-center gap-7 md:flex">
            {
                HEADER_LINK.map((link) => (
                    <a
                        href={link.href}
                        class="text-sm text-muted-foreground uppercase transition-colors hover:text-foreground"
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <div class="flex shrink-0 items-center gap-2">
            <!--
                The narrowest phone has room for the lockup and two controls but not for two
                labelled ones, and the install pill is the one that has to keep its word. The mark
                alone is what a reader recognises here anyway, so the label goes and the link keeps
                its name for anything not reading pixels.
            -->
            <a
                href={REPOSITORY_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="OpenLab on GitHub"
                class="flex items-center gap-2 rounded-full border border-border px-3 py-2 text-sm text-muted-foreground transition-colors hover:border-foreground hover:text-foreground sm:px-4"
            >
                <svg class="size-4 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                    <path
                        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
                    ></path>
                </svg>
                <span class="hidden sm:inline">Source</span>
            </a>
            <a
                href="#install"
                class="rounded-full bg-brand px-4 py-2 text-sm font-[620] text-brand-foreground transition-opacity hover:opacity-85"
            >
                Install
            </a>
        </div>
    </div>
</header>
