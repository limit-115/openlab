---
/**
 * The product mark: the lab's boundary drawn as four crop marks, with a flask standing inside it.
 * It paints in `currentColor`, so it takes the colour of whatever it sits in and follows the
 * reader's light or dark setting without a second copy of the drawing.
 *
 * The geometry is the brand pack's, stated in `brand/README.md` and drawn on a 64-unit grid. The
 * pack generates every file from that one geometry; this is a hand copy of it for a page that
 * ships no JavaScript, so it is changed only by copying the pack again, never by editing here.
 */
type Props = {
    class?: string;
};

const { class: className } = Astro.props;
---

<svg viewBox="0 0 64 64" fill="none" role="img" aria-label="OpenLab" class={className}>
    <g stroke="currentColor" stroke-width={3} stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 20V9H20"></path>
        <path d="M44 9H55V20"></path>
        <path d="M55 44V55H44"></path>
        <path d="M20 55H9V44"></path>
    </g>
    <!-- Flask glyph: flask-conical from Lucide (lucide.dev), ISC. See brand/ATTRIBUTION.md. -->
    <g
        transform="translate(14.6 14.6) scale(1.45)"
        stroke="currentColor"
        stroke-width={2}
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path
            d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"
        ></path>
        <path d="M6.453 15h11.094"></path>
        <path d="M8.5 2h7"></path>
    </g>
</svg>
