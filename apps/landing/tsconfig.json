{
    "extends": ["../../tsconfig.base.json", "astro/tsconfigs/strict"],
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["astro/client"],
        "paths": {
            "#src/*": ["./src/*"]
        },
        "allowImportingTsExtensions": false,
        "rewriteRelativeImportExtensions": false
    },
    "include": [".astro/types.d.ts", "src/**/*.ts", "astro.config.ts"],
    "exclude": ["dist"]
}
