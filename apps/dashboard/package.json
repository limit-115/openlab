{
    "name": "@lab/dashboard",
    "version": "0.1.0",
    "private": true,
    "description": "Local observer dashboard for AI Research Lab",
    "type": "module",
    "imports": {
        "#src/*": "./src/*"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -p tsconfig.json && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "lint": "biome lint .",
        "format": "biome format --write ."
    },
    "dependencies": {
        "@lab/protocol": "workspace:*",
        "@tanstack/react-query": "5.101.4",
        "lucide-react": "1.28.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/jest-dom": "7.0.0",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/react": "19.2.18",
        "@types/react-dom": "19.2.4",
        "@vitejs/plugin-react": "6.0.5",
        "jsdom": "30.0.1",
        "tailwindcss": "4.3.3",
        "vite": "8.2.0"
    },
    "license": "UNLICENSED"
}
